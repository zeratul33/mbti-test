---
export interface Props {
  type: 'betterhelp';
}
---
<div class="bg-paper rounded-[36px] p-6 transition-transform duration-300 hover:-translate-y-[3px]"
     style="border:1px solid var(--ink-line);box-shadow:0 1px 2px 0 rgba(31,26,20,0.05)">
  <p class="mono-cap mb-3">Sponsored</p>
  <h3 class="font-sans font-extrabold text-lg text-ink tracking-tight mb-2">Professional Online Therapy</h3>
  <p class="text-sm text-ink-mute leading-relaxed mb-4">
    Understanding your personality type can be the first step. BetterHelp connects you
    with a licensed therapist who can help you grow — on your schedule.
  </p>
  <a
    href="https://www.betterhelp.com/typeinsight"
    target="_blank"
    rel="noopener sponsored"
    class="inline-block bg-clay text-paper font-sans text-sm font-semibold px-6 py-3 rounded-full transition-colors hover:bg-clay-deep"
  >
    Get Started with BetterHelp
  </a>
  <p class="text-xs text-ink-mute mt-3">
    TypeInsight may earn a commission from qualifying purchases. This does not affect the
    price you pay. We only recommend services we believe in.
  </p>
</div>
