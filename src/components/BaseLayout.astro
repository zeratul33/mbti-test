---
import SEOHead from './SEOHead.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  faqItems?: { question: string; answer: string }[];
}

const { title, description, canonical, faqItems } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <meta name='impact-site-verification' value='387fda3f-b1e8-45e6-8ffd-f5ca9093a667'>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      faqItems={faqItems}
    />
  </head>
  <body class="bg-cream min-h-screen flex flex-col">
    <header class="sticky top-0 z-50" style="background:rgba(245,239,227,0.85);backdrop-filter:blur(14px);border-bottom:1px solid var(--ink-line)">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="font-sans font-extrabold text-xl tracking-tight text-ink">
          TypeInsight
        </a>
        <nav class="flex gap-6 text-sm text-ink-mute font-sans">
          <a href="/" class="hover:text-ink transition-colors">Home</a>
          <a href="/test" class="hover:text-ink transition-colors">Take the Test</a>
        </nav>
      </div>
      
    </header>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1450495553491093"
     crossorigin="anonymous"></script>
<!-- mbti-style -->
<ins class="adsbygoogle"
     style="display:block"
     data-ad-client="ca-pub-1450495553491093"
     data-ad-slot="5532145773"
     data-ad-format="auto"
     data-full-width-responsive="true"></ins>
<script>
     (adsbygoogle = window.adsbygoogle || []).push({});
</script>

    <main class="flex-1">
      <slot />
      
    </main>

    <Footer />

    <script>
      const obs = new IntersectionObserver(
        es => es.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
    </script>
  </body>
</html>
