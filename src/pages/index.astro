---
import BaseLayout from '../components/BaseLayout.astro';

const features = [
  { label: 'Your Cognitive Style', body: 'Understand how you take in information and make decisions — the mental habits that shape every interaction.' },
  { label: 'Strengths & Blind Spots', body: 'Honest, specific strengths you can lean into, and the growth edges that hold you back.' },
  { label: 'Career Alignment', body: 'Six career paths where your type tends to thrive, grounded in real occupational data.' },
  { label: 'Growth Roadmap', body: 'Practical areas to develop so your type works for you rather than against you.' },
];
---

<BaseLayout
  title="TypeInsight — Free MBTI Personality Test"
  description="Discover your Myers-Briggs personality type in 10 questions. Science-based, free, and no sign-up required."
>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-16">
    <div class="lg:grid lg:gap-16 items-center" style="grid-template-columns:1.2fr 1fr;">
      <div>
        <p class="mono-cap mb-6">Personality &amp; Career</p>
        <h1 class="font-sans font-extrabold text-ink mb-6 reveal"
            style="font-size:clamp(2.8rem,6vw,5rem);letter-spacing:-0.05em;line-height:0.95;">
          Know Yourself.<br/>Lead Better.
        </h1>
        <p class="text-ink-mute font-sans text-lg max-w-xl mb-10 leading-relaxed">
          TypeInsight is a free, research-informed MBTI-style test that reveals your
          personality type — and what it means for your work, relationships, and growth.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/test"
             class="bg-ink text-paper font-sans text-sm font-semibold px-6 py-3 rounded-full transition-all hover:-translate-y-px inline-block"
             style="letter-spacing:-0.01em;">Take the Free Test</a>
          <a href="/test"
             class="font-sans text-sm font-semibold px-6 py-3 rounded-full transition-all hover:bg-bone inline-block"
             style="border:1px solid rgba(31,26,20,0.28);color:#1F1A14;letter-spacing:-0.01em;">
            See All 16 Types</a>
        </div>
        <p class="mono-cap mt-5" style="font-size:0.7rem;">10 questions — no account needed</p>
      </div>
      <div class="hidden lg:flex flex-col gap-4 mt-8 lg:mt-0">
        {[
          { num: '16', label: 'Personality Types' },
          { num: '10', label: 'Questions Only' },
          { num: '<3 min', label: 'Avg Completion' },
        ].map(({ num, label }) => (
          <div class="bg-paper rounded-[28px] px-6 py-5 reveal" style="border:1px solid var(--ink-line);">
            <p class="font-sans font-extrabold text-3xl text-ink" style="letter-spacing:-0.04em;">{num}</p>
            <p class="mono-cap mt-1">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature grid -->
  <section class="bg-sage-mist py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="md:grid md:gap-12 mb-12" style="grid-template-columns:1.4fr 1fr;">
        <h2 class="font-sans font-extrabold text-ink text-3xl mb-4 md:mb-0"
            style="letter-spacing:-0.04em;">What TypeInsight Tells You</h2>
        <p class="text-ink-mute font-sans text-base leading-relaxed self-end">
          Each result page gives you a complete profile — not just a label.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {features.map(({ label, body }) => (
          <div class="bg-paper rounded-[36px] p-8 hover:-translate-y-[3px] transition-all duration-300"
               style="border:1px solid var(--ink-line);box-shadow:0 1px 2px 0 rgba(31,26,20,0.05);">
            <h3 class="font-sans font-extrabold text-ink text-base mb-3"
                style="letter-spacing:-0.03em;">{label}</h3>
            <p class="text-ink-mute text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="max-w-5xl mx-auto px-6 py-20 text-center">
    <p class="mono-cap mb-4">Get started</p>
    <p class="font-sans font-extrabold text-ink text-3xl mb-8"
       style="letter-spacing:-0.04em;">Ready to find your type?</p>
    <a href="/test"
       class="inline-block bg-clay text-paper font-sans text-sm font-semibold px-7 py-3 rounded-full transition-all hover:-translate-y-px"
       style="letter-spacing:-0.01em;">
      Start the Test
    </a>
  </section>
</BaseLayout>
