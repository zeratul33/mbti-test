---
import BaseLayout from '../../components/BaseLayout.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const type = "ESFP";
const nickname = "The Entertainer";
const tagline = "Spontaneous, energetic, and magnetic — the person who makes ordinary moments feel like events.";

const strengths = [
  "Infectious enthusiasm and warmth",
  "Exceptional ability to connect with people instantly",
  "Highly observant of others' emotions",
  "Practical and resourceful in the present moment",
  "Brings fun and energy to any environment",
];

const growthEdges = [
  "Avoids difficult conversations and long-term planning",
  "Can be easily distracted or unfocused",
  "Sensitive to criticism and conflict",
  "May over-prioritise fun at the expense of responsibility",
  "Struggles with abstract or theoretical tasks",
];

const careers = [
  "Actor / Entertainer", "Event Planner", "Sales Representative",
  "Flight Attendant", "Childcare Worker", "Personal Trainer",
];

const stats = [
  { label: "Population", value: "~7–10%" },
  { label: "Energy", value: "Extraverted" },
  { label: "Information", value: "Sensing" },
  { label: "Decisions", value: "Feeling" },
  { label: "Lifestyle", value: "Perceiving" },
];

const loveStyle = {
  summary: `ESFPs are vivid, physically affectionate, and present-focused in romance. They bring excitement, fun, and genuine warmth to relationships and are naturally gifted at making a partner feel seen and celebrated in the moment. Love, for an ESFP, is meant to be felt — not planned.`,
  what_they_need: `A partner who is up for adventure, comfortable with spontaneity, and doesn't treat every day as a logistical problem to solve. ESFPs need to feel free to be themselves without constant expectation management or emotional heaviness.`,
  challenge: `Long-term planning and navigating relationship depth. ESFPs excel in the early stages of romance but can find the heavier emotional work of sustained commitment — conflict resolution, future planning, sitting with difficulty — less intuitive territory. Growing through those stages is where real intimacy is built.`,
};
---

<BaseLayout
  title="ESFP Personality: Love, Strengths & Careers | TypeInsight"
  description="How does the ESFP love? Romantic style, relationship needs, career paths and growth areas for The Entertainer. MBTI 恋愛 ESFP / ESFP 恋爱."
  faqItems={[
    {
      question: "How does an ESFP act in a romantic relationship?",
      answer: "ESFPs are spontaneous, physically affectionate partners who bring fun and warmth to romance. They excel at making a partner feel celebrated in the present moment, though sustaining the deeper work of long-term partnership requires deliberate growth.",
    },
    {
      question: "ESFP の恋愛スタイルは？(ESFP love style / ESFP 恋爱风格)",
      answer: "ESFP types love with presence and energy — they are vivid, sensory, and generous partners. They are most fulfilled with partners who share their love of adventure and don't require emotional heaviness as proof of commitment.",
    },
    {
      question: "What MBTI type is most compatible with ESFP?",
      answer: "ISFJs and ISTJs are often cited as strong ESFP matches — their reliability and structure complement the ESFP's spontaneity, providing the stability that allows the ESFP's energy to flourish sustainably. ISFJ is a particularly common pairing.",
    },
  ]}
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <p class="mono-cap mb-4">Your Result</p>
    <h1 class="font-sans font-extrabold text-ink leading-none mb-2" style="font-size:clamp(3.5rem,8vw,6rem);letter-spacing:-0.06em;line-height:0.9">{type}</h1>
    <p class="font-sans text-2xl font-semibold text-clay mb-4">{nickname}</p>
    <p class="font-sans text-ink-mute max-w-xl text-base leading-relaxed">{tagline}</p>
    <div class="mt-8">
      <a href="/test" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full transition-colors hover:bg-ink hover:text-paper" style="border:1px solid rgba(31,26,20,0.28)">Retake the Test</a>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-14 lg:grid lg:grid-cols-3 lg:gap-12">
    <div class="lg:col-span-2 space-y-12">
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Profile</h2>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>The ESFP — Extraverted, Sensing, Feeling, Perceiving — is The Entertainer: a type that lives fully in the present and brings others along for the ride. ESFPs are among the most socially vibrant personalities, combining genuine warmth with an instinctive ability to read and respond to the energy around them.</p>
          <p>ESFPs don't perform joy — they generate it. Their enthusiasm is authentic, their attention to others is real, and their ability to make people feel noticed and valued is a natural gift. In environments that reward human connection, creativity, and adaptability, ESFPs thrive.</p>
          <p>The challenge for ESFPs is the long game. Their present-focus is a genuine strength in most social and reactive situations, but it can become a liability when sustained effort, deferred gratification, or abstract planning are required. The bills that haven't been filed, the difficult conversation that keeps getting postponed — these are the pressure points.</p>
          <p>Growth for ESFPs involves building the scaffolding that allows their spontaneity to operate sustainably: a few systems, a few routines, a willingness to sit with discomfort long enough to address it before it becomes a crisis.</p>
        </div>
      </section>

      <!-- Ad: 300x250 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '6d2f9a9789ee0cb5604b21dbdb334ecb',
            'format' : 'iframe',
            'height' : 250,
            'width' : 300,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/6d2f9a9789ee0cb5604b21dbdb334ecb/invoke.js"></script>
      </div>

            <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Strengths</h2>
        <ul class="space-y-3">
          {strengths.map(s => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-sage font-bold mt-0.5">&#10003;</span><span>{s}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Growth Edges</h2>
        <ul class="space-y-3">
          {growthEdges.map(g => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-clay font-bold mt-0.5">&rarr;</span><span>{g}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Career Paths</h2>
        <div class="flex flex-wrap gap-2">
          {careers.map(c => (
            <span class="font-sans text-sm font-medium px-4 py-2 rounded-full text-ink-soft"
                  style="background:#ECEFE2;border:1px solid var(--ink-line);">{c}</span>
          ))}
        </div>
      </section>

      <!-- Love & Relationships -->
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-2" style="letter-spacing:-0.04em;">
          Love &amp; Relationships
        </h2>
        <p class="font-sans text-xs text-ink-mute mb-5" style="letter-spacing:0.02em;">
          <span lang="ja">恋愛スタイル</span> &nbsp;/&nbsp; <span lang="zh-Hans">恋爱类型</span>
        </p>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>{loveStyle.summary}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            What they need in a partner
          </h3>
          <p>{loveStyle.what_they_need}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            Relationship challenge
          </h3>
          <p>{loveStyle.challenge}</p>
        </div>
      </section>
    </div>

    <aside class="mt-12 lg:mt-0 space-y-8">
      <!-- Ad: 160x300 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '70ef5f288f802563b40dd7d981408065',
            'format' : 'iframe',
            'height' : 300,
            'width' : 160,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/70ef5f288f802563b40dd7d981408065/invoke.js"></script>
      </div>

      <div class="bg-paper rounded-[36px] p-6" style="border:1px solid var(--ink-line)">
        <p class="mono-cap mb-4">At a Glance</p>
        <dl class="space-y-3">
          {stats.map(({ label, value }) => (
            <div class="flex justify-between text-sm font-sans pb-2" style="border-bottom:1px solid var(--ink-line)">
              <dt class="text-ink-mute">{label}</dt>
              <dd class="text-ink font-semibold">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <AffiliateCard type="betterhelp" />
    </aside>
  </div>
</BaseLayout>
