---
import BaseLayout from '../../components/BaseLayout.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const type = "ENFJ";
const nickname = "The Protagonist";
const tagline = "Charismatic, empathetic, and driven by the conviction that they can help people grow.";

const strengths = [
  "Exceptional ability to inspire and motivate others",
  "Warm, perceptive, and emotionally attuned",
  "Natural organiser of people toward shared goals",
  "Articulate and persuasive communicator",
  "Deeply committed to personal and social growth",
];

const growthEdges = [
  "Over-invests in others' problems at the expense of own needs",
  "Can be preachy or moralistic when values are threatened",
  "Struggles to receive criticism without taking it personally",
  "May suppress own needs to maintain harmony",
  "Tendency to idealise people and then feel betrayed",
];

const careers = [
  "Teacher / Professor", "HR Director", "Non-profit Leader",
  "Life Coach", "Diplomat", "Motivational Speaker",
];

const stats = [
  { label: "Population", value: "~2%" },
  { label: "Energy", value: "Extraverted" },
  { label: "Information", value: "Intuitive" },
  { label: "Decisions", value: "Feeling" },
  { label: "Lifestyle", value: "Judging" },
];
---

<BaseLayout
  title="ENFJ — The Protagonist Personality Type | TypeInsight"
  description="Full profile of the ENFJ personality: strengths, blind spots, career paths, and growth areas for The Protagonist."
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <p class="mono-cap mb-4">Your Result</p>
    <h1 class="font-sans font-extrabold text-ink leading-none mb-2" style="font-size:clamp(3.5rem,8vw,6rem);letter-spacing:-0.06em;line-height:0.9">{type}</h1>
    <p class="font-sans text-2xl font-semibold text-clay mb-4">{nickname}</p>
    <p class="font-sans text-ink-mute max-w-xl text-base leading-relaxed">{tagline}</p>
    <div class="mt-8">
      <a href="/test" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full transition-colors hover:bg-ink hover:text-paper" style="border:1px solid rgba(31,26,20,0.28)">Retake the Test</a>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-14 lg:grid lg:grid-cols-3 lg:gap-12">
    <div class="lg:col-span-2 space-y-12">
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Profile</h2>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>The ENFJ — Extraverted, Intuitive, Feeling, Judging — is The Protagonist: a natural leader who measures success not by personal achievement but by the growth of those around them. ENFJs are among the most people-centred of all types, with an almost uncanny ability to read a room and adjust accordingly.</p>
          <p>Where other leaders direct, ENFJs inspire. They operate through vision, warmth, and genuine belief in what people are capable of. At their best, they draw out potential that others haven't noticed — and build loyal, motivated teams in the process.</p>
          <p>The same attunement that makes ENFJs exceptional leaders can become a liability. They absorb the emotional atmosphere around them, making it difficult to stay objective when those they care about are struggling. Boundaries are not natural for this type; they must be cultivated deliberately.</p>
          <p>Growth for ENFJs often involves learning to extend to themselves the same compassion and patience they freely give others — and recognising that their value is not contingent on being perpetually available.</p>
        </div>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Strengths</h2>
        <ul class="space-y-3">
          {strengths.map(s => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-sage font-bold mt-0.5">&#10003;</span><span>{s}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Growth Edges</h2>
        <ul class="space-y-3">
          {growthEdges.map(g => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-clay font-bold mt-0.5">&rarr;</span><span>{g}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Career Paths</h2>
        <div class="flex flex-wrap gap-2">
          {careers.map(c => (
            <span class="font-sans text-sm font-medium px-4 py-2 rounded-full text-ink-soft"
                  style="background:#ECEFE2;border:1px solid var(--ink-line);">{c}</span>
          ))}
        </div>
      </section>
    </div>

    <aside class="mt-12 lg:mt-0 space-y-8">
      <div class="bg-paper rounded-[36px] p-6" style="border:1px solid var(--ink-line)">
        <p class="mono-cap mb-4">At a Glance</p>
        <dl class="space-y-3">
          {stats.map(({ label, value }) => (
            <div class="flex justify-between text-sm font-sans pb-2" style="border-bottom:1px solid var(--ink-line)">
              <dt class="text-ink-mute">{label}</dt>
              <dd class="text-ink font-semibold">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <AffiliateCard type="betterhelp" />
    </aside>
  </div>
</BaseLayout>
