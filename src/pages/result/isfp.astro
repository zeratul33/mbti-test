---
import BaseLayout from '../../components/BaseLayout.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const type = "ISFP";
const nickname = "The Adventurer";
const tagline = "Sensitive, creative, and fiercely authentic — living fully in the present moment.";

const strengths = [
  "Genuine warmth and openness",
  "Strong aesthetic sensibility",
  "Flexible and easy to be around",
  "Deeply attuned to their own values",
  "Curious and open to new experiences",
];

const growthEdges = [
  "Conflict avoidance that allows problems to fester",
  "Difficulty with long-term planning",
  "Unpredictable — can withdraw without explanation",
  "Overly self-critical",
  "Struggles to assert boundaries clearly",
];

const careers = [
  "Visual Artist / Illustrator", "Musician", "Physical Therapist",
  "Fashion Designer", "Chef", "Veterinary Nurse",
];

const stats = [
  { label: "Population", value: "~5–9%" },
  { label: "Energy", value: "Introverted" },
  { label: "Information", value: "Sensing" },
  { label: "Decisions", value: "Feeling" },
  { label: "Lifestyle", value: "Perceiving" },
];

const loveStyle = {
  summary: `ISFPs are gentle, sensory, and intensely present in love. They don't perform affection — they live it, through touch, shared experience, and quiet acts of care. An ISFP in love is authentically warm and deeply loyal to the people they choose, even if that loyalty is rarely announced.`,
  what_they_need: `Freedom to be fully themselves and a partner who values authentic connection over social performance. ISFPs are sensitive to inauthenticity and disengage from relationships that require them to perform a version of themselves they don't recognise.`,
  challenge: `Articulating needs and navigating conflict. ISFPs tend to avoid confrontation, sometimes withdrawing entirely rather than naming a problem. This avoidance protects them in the short term but can quietly accumulate into distance that becomes difficult to bridge.`,
};
---

<BaseLayout
  title="ISFP Personality: Love, Strengths & Careers | TypeInsight"
  description="How does the ISFP love? Romantic style, relationship needs, career paths and growth areas for The Adventurer. MBTI 恋愛 ISFP / ISFP 恋爱."
  faqItems={[
    {
      question: "How does an ISFP act in a romantic relationship?",
      answer: "ISFPs are gentle, authentic partners who express love through presence and quiet acts of care. They are deeply loyal but tend to avoid conflict — which can allow unaddressed issues to build over time. They need partners who value authenticity over performance.",
    },
    {
      question: "ISFP の恋愛スタイルは？(ISFP love style / ISFP 恋爱风格)",
      answer: "ISFP types love with sensory warmth and genuine loyalty. They are present-focused and expressive through action rather than words. They are most fulfilled with partners who honour their need for freedom and authentic self-expression.",
    },
    {
      question: "What MBTI type is most compatible with ISFP?",
      answer: "ESFJs and ENFJs are often cited as complementary matches for ISFPs — they offer warmth, structure, and outward expressiveness that balances the ISFP's quieter, more private style. ESFJ is a particularly common pairing.",
    },
  ]}
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <p class="mono-cap mb-4">Your Result</p>
    <h1 class="font-sans font-extrabold text-ink leading-none mb-2" style="font-size:clamp(3.5rem,8vw,6rem);letter-spacing:-0.06em;line-height:0.9">{type}</h1>
    <p class="font-sans text-2xl font-semibold text-clay mb-4">{nickname}</p>
    <p class="font-sans text-ink-mute max-w-xl text-base leading-relaxed">{tagline}</p>
    <div class="mt-8">
      <a href="/test" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full transition-colors hover:bg-ink hover:text-paper" style="border:1px solid rgba(31,26,20,0.28)">Retake the Test</a>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-14 lg:grid lg:grid-cols-3 lg:gap-12">
    <div class="lg:col-span-2 space-y-12">
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Profile</h2>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>The ISFP — Introverted, Sensing, Feeling, Perceiving — is The Adventurer: a type that lives close to the texture of immediate experience. ISFPs don't operate through abstract plans; they respond to what is present, beautiful, or meaningful right now.</p>
          <p>ISFPs are among the most aesthetically gifted of all types. Whether or not they work in formally creative fields, they notice beauty and create it naturally — in how they dress, how they arrange a space, how they move through the world. This sensory attunement is a genuine intelligence, not a preference.</p>
          <p>Emotionally, ISFPs are warm but private. They feel deeply and are capable of great loyalty and compassion, but they rarely articulate this directly. People who know them well recognise the care in small actions; those who don't may miss it entirely.</p>
          <p>The ISFP's central challenge is navigating the structures of adult life — careers, commitments, plans — in a way that doesn't feel like a cage. The path forward usually involves finding environments that honour their autonomy and values rather than trying to make themselves conform to environments that don't.</p>
        </div>
      </section>

      <!-- Ad: 300x250 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '6d2f9a9789ee0cb5604b21dbdb334ecb',
            'format' : 'iframe',
            'height' : 250,
            'width' : 300,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/6d2f9a9789ee0cb5604b21dbdb334ecb/invoke.js"></script>
      </div>

            <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Strengths</h2>
        <ul class="space-y-3">
          {strengths.map(s => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-sage font-bold mt-0.5">&#10003;</span><span>{s}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Growth Edges</h2>
        <ul class="space-y-3">
          {growthEdges.map(g => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-clay font-bold mt-0.5">&rarr;</span><span>{g}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Career Paths</h2>
        <div class="flex flex-wrap gap-2">
          {careers.map(c => (
            <span class="font-sans text-sm font-medium px-4 py-2 rounded-full text-ink-soft"
                  style="background:#ECEFE2;border:1px solid var(--ink-line);">{c}</span>
          ))}
        </div>
      </section>

      <!-- Love & Relationships -->
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-2" style="letter-spacing:-0.04em;">
          Love &amp; Relationships
        </h2>
        <p class="font-sans text-xs text-ink-mute mb-5" style="letter-spacing:0.02em;">
          <span lang="ja">恋愛スタイル</span> &nbsp;/&nbsp; <span lang="zh-Hans">恋爱类型</span>
        </p>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>{loveStyle.summary}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            What they need in a partner
          </h3>
          <p>{loveStyle.what_they_need}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            Relationship challenge
          </h3>
          <p>{loveStyle.challenge}</p>
        </div>
      </section>
    </div>

    <aside class="mt-12 lg:mt-0 space-y-8">
      <!-- Ad: 160x300 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '70ef5f288f802563b40dd7d981408065',
            'format' : 'iframe',
            'height' : 300,
            'width' : 160,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/70ef5f288f802563b40dd7d981408065/invoke.js"></script>
      </div>

      <div class="bg-paper rounded-[36px] p-6" style="border:1px solid var(--ink-line)">
        <p class="mono-cap mb-4">At a Glance</p>
        <dl class="space-y-3">
          {stats.map(({ label, value }) => (
            <div class="flex justify-between text-sm font-sans pb-2" style="border-bottom:1px solid var(--ink-line)">
              <dt class="text-ink-mute">{label}</dt>
              <dd class="text-ink font-semibold">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <AffiliateCard type="betterhelp" />
    </aside>
  </div>
</BaseLayout>
