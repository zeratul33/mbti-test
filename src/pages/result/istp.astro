---
import BaseLayout from '../../components/BaseLayout.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const type = "ISTP";
const nickname = "The Virtuoso";
const tagline = "Calm, observant, and masterful with their hands — the person who fixes things nobody else can.";

const strengths = [
  "Exceptional practical problem-solving",
  "Cool-headed under pressure",
  "Highly observant of mechanical and physical systems",
  "Independent and self-sufficient",
  "Adaptable and responsive in a crisis",
];

const growthEdges = [
  "Emotionally reserved to a fault — others may feel shut out",
  "Bored quickly by routine or repetition",
  "Dislikes long-term commitment and planning",
  "Can be insensitive to others' emotional needs",
  "Tendency to take unnecessary risks for the thrill",
];

const careers = [
  "Engineer / Mechanic", "Surgeon", "Pilot",
  "Forensic Scientist", "Carpenter / Craftsperson", "Paramedic",
];

const stats = [
  { label: "Population", value: "~5%" },
  { label: "Energy", value: "Introverted" },
  { label: "Information", value: "Sensing" },
  { label: "Decisions", value: "Thinking" },
  { label: "Lifestyle", value: "Perceiving" },
];
---

<BaseLayout
  title="ISTP — The Virtuoso Personality Type | TypeInsight"
  description="Full profile of the ISTP personality: strengths, blind spots, career paths, and growth areas for The Virtuoso."
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <p class="mono-cap mb-4">Your Result</p>
    <h1 class="font-sans font-extrabold text-ink leading-none mb-2" style="font-size:clamp(3.5rem,8vw,6rem);letter-spacing:-0.06em;line-height:0.9">{type}</h1>
    <p class="font-sans text-2xl font-semibold text-clay mb-4">{nickname}</p>
    <p class="font-sans text-ink-mute max-w-xl text-base leading-relaxed">{tagline}</p>
    <div class="mt-8">
      <a href="/test" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full transition-colors hover:bg-ink hover:text-paper" style="border:1px solid rgba(31,26,20,0.28)">Retake the Test</a>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-14 lg:grid lg:grid-cols-3 lg:gap-12">
    <div class="lg:col-span-2 space-y-12">
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Profile</h2>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>The ISTP — Introverted, Sensing, Thinking, Perceiving — is The Virtuoso: a type that understands the physical world at a level others rarely match. ISTPs are at their best when something is broken, a crisis is unfolding, or a system needs to be understood from the inside out.</p>
          <p>ISTPs don't learn by reading about things — they learn by taking them apart. This hands-on intelligence is rare and valuable, but it often goes unrecognised in educational and corporate environments that reward verbal and abstract thinking.</p>
          <p>Emotionally, ISTPs are private. They are not unfeeling — they simply process internally and see no particular reason to verbalise what seems obvious to them. This can make them seem distant or indifferent to partners and colleagues who communicate differently.</p>
          <p>The ISTP's growth edge is relational patience: learning to translate their internal experience into external communication, and to sustain commitment to people and projects beyond the initial interesting phase.</p>
        </div>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Strengths</h2>
        <ul class="space-y-3">
          {strengths.map(s => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-sage font-bold mt-0.5">&#10003;</span><span>{s}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Growth Edges</h2>
        <ul class="space-y-3">
          {growthEdges.map(g => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-clay font-bold mt-0.5">&rarr;</span><span>{g}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Career Paths</h2>
        <div class="flex flex-wrap gap-2">
          {careers.map(c => (
            <span class="font-sans text-sm font-medium px-4 py-2 rounded-full text-ink-soft"
                  style="background:#ECEFE2;border:1px solid var(--ink-line);">{c}</span>
          ))}
        </div>
      </section>
    </div>

    <aside class="mt-12 lg:mt-0 space-y-8">
      <div class="bg-paper rounded-[36px] p-6" style="border:1px solid var(--ink-line)">
        <p class="mono-cap mb-4">At a Glance</p>
        <dl class="space-y-3">
          {stats.map(({ label, value }) => (
            <div class="flex justify-between text-sm font-sans pb-2" style="border-bottom:1px solid var(--ink-line)">
              <dt class="text-ink-mute">{label}</dt>
              <dd class="text-ink font-semibold">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <AffiliateCard type="betterhelp" />
    </aside>
  </div>
</BaseLayout>
