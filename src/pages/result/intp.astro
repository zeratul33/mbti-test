---
import BaseLayout from '../../components/BaseLayout.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const type = "INTP";
const nickname = "The Logician";
const tagline = "Endlessly curious, intellectually precise, and driven by the need to understand.";

const strengths = [
  "Deep analytical and logical thinking",
  "Highly creative problem-solving",
  "Open-minded and receptive to new ideas",
  "Objective and impartial reasoning",
  "Intense focus when engaged",
];

const growthEdges = [
  "Can seem detached or indifferent to others' feelings",
  "Prone to overthinking and analysis paralysis",
  "Struggles to follow through on implementation",
  "May come across as condescending unintentionally",
  "Avoids routine and can neglect practical responsibilities",
];

const careers = [
  "Software Engineer", "Mathematician", "Philosopher / Academic",
  "Data Scientist", "Researcher", "Game Designer",
];

const stats = [
  { label: "Population", value: "~3%" },
  { label: "Energy", value: "Introverted" },
  { label: "Information", value: "Intuitive" },
  { label: "Decisions", value: "Thinking" },
  { label: "Lifestyle", value: "Perceiving" },
];

const loveStyle = {
  summary: `INTPs are unconventional, genuine, and quietly devoted once they have chosen a partner. They don't perform romance — what they offer is authentic intellectual companionship, loyalty, and the rare experience of being accepted exactly as you are. An INTP's love is understated but it is real.`,
  what_they_need: `A partner who values intellectual exploration and respects their need for extended alone time. INTPs need significant mental autonomy and are most comfortable with partners who have their own rich inner life and don't require constant social engagement.`,
  challenge: `Relationship maintenance and emotional expression. INTPs can forget that relationships require regular tending — that a partner needs presence and acknowledgment, not just occasional profound connection. Translating internal care into visible behaviour is real growth work for this type.`,
};
---

<BaseLayout
  title="INTP Personality: Love, Strengths & Careers | TypeInsight"
  description="How does the INTP love? Romantic style, relationship needs, career paths and growth areas for The Logician. MBTI 恋愛 INTP / INTP 恋爱."
  faqItems={[
    {
      question: "How does an INTP act in a romantic relationship?",
      answer: "INTPs are genuine, unconventional partners who offer intellectual depth and quiet loyalty. They don't perform romance — they offer authentic presence and the rare gift of full acceptance. But they must actively work to maintain emotional connection and make care visible.",
    },
    {
      question: "INTP の恋愛スタイルは？(INTP love style / INTP 恋爱风格)",
      answer: "INTP types love authentically but quietly. They bond through shared intellectual curiosity and give their partners full autonomy. Their challenge is translating deep internal care into the external gestures and presence a partner can actually experience.",
    },
    {
      question: "What MBTI type is most compatible with INTP?",
      answer: "ENTJs and ENFJs are often cited as strong INTP matches — they provide the external structure, warmth, and social energy that balances the INTP's introverted analytical nature. ENTJ is a particularly common pairing with strong intellectual chemistry.",
    },
  ]}
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <p class="mono-cap mb-4">Your Result</p>
    <h1 class="font-sans font-extrabold text-ink leading-none mb-2" style="font-size:clamp(3.5rem,8vw,6rem);letter-spacing:-0.06em;line-height:0.9">{type}</h1>
    <p class="font-sans text-2xl font-semibold text-clay mb-4">{nickname}</p>
    <p class="font-sans text-ink-mute max-w-xl text-base leading-relaxed">{tagline}</p>
    <div class="mt-8">
      <a href="/test" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full transition-colors hover:bg-ink hover:text-paper" style="border:1px solid rgba(31,26,20,0.28)">Retake the Test</a>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-14 lg:grid lg:grid-cols-3 lg:gap-12">
    <div class="lg:col-span-2 space-y-12">
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Profile</h2>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>The INTP — Introverted, Intuitive, Thinking, Perceiving — is The Logician: a type defined by an insatiable appetite for ideas and an almost compulsive need to understand how things work. INTPs are the architects of theory, happiest when pulling apart assumptions and rebuilding them from cleaner foundations.</p>
          <p>Where others accept convention, the INTP interrogates it. They are natural sceptics — not cynics — who withhold commitment until the evidence is genuinely compelling. This intellectual rigour makes them exceptional at spotting flaws in arguments and designing elegant solutions to abstract problems.</p>
          <p>The tension for INTPs lies between the worlds of ideas and execution. A blueprint is endlessly satisfying; the repetitive work of building it, less so. INTPs often produce brilliant theoretical work that stalls at the prototype stage, not from laziness but from a genuine pull toward the next interesting problem.</p>
          <p>Interpersonally, INTPs can be warm and generous once trust is established, but their default mode is reserved. They prioritise honesty over tact — sometimes to a fault — and may not notice when bluntness lands harder than intended.</p>
        </div>
      </section>

      <!-- Ad: 300x250 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '6d2f9a9789ee0cb5604b21dbdb334ecb',
            'format' : 'iframe',
            'height' : 250,
            'width' : 300,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/6d2f9a9789ee0cb5604b21dbdb334ecb/invoke.js"></script>
      </div>

            <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Strengths</h2>
        <ul class="space-y-3">
          {strengths.map(s => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-sage font-bold mt-0.5">&#10003;</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Growth Edges</h2>
        <ul class="space-y-3">
          {growthEdges.map(g => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-clay font-bold mt-0.5">&rarr;</span>
              <span>{g}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Career Paths</h2>
        <div class="flex flex-wrap gap-2">
          {careers.map(c => (
            <span class="font-sans text-sm font-medium px-4 py-2 rounded-full text-ink-soft"
                  style="background:#ECEFE2;border:1px solid var(--ink-line);">{c}</span>
          ))}
        </div>
      </section>

      <!-- Love & Relationships -->
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-2" style="letter-spacing:-0.04em;">
          Love &amp; Relationships
        </h2>
        <p class="font-sans text-xs text-ink-mute mb-5" style="letter-spacing:0.02em;">
          <span lang="ja">恋愛スタイル</span> &nbsp;/&nbsp; <span lang="zh-Hans">恋爱类型</span>
        </p>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>{loveStyle.summary}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            What they need in a partner
          </h3>
          <p>{loveStyle.what_they_need}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            Relationship challenge
          </h3>
          <p>{loveStyle.challenge}</p>
        </div>
      </section>
    </div>

    <aside class="mt-12 lg:mt-0 space-y-8">
      <!-- Ad: 160x300 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '70ef5f288f802563b40dd7d981408065',
            'format' : 'iframe',
            'height' : 300,
            'width' : 160,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/70ef5f288f802563b40dd7d981408065/invoke.js"></script>
      </div>

      <div class="bg-paper rounded-[36px] p-6" style="border:1px solid var(--ink-line)">
        <p class="mono-cap mb-4">At a Glance</p>
        <dl class="space-y-3">
          {stats.map(({ label, value }) => (
            <div class="flex justify-between text-sm font-sans pb-2" style="border-bottom:1px solid var(--ink-line)">
              <dt class="text-ink-mute">{label}</dt>
              <dd class="text-ink font-semibold">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <AffiliateCard type="betterhelp" />
    </aside>
  </div>
</BaseLayout>
