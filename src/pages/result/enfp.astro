---
import BaseLayout from '../../components/BaseLayout.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const type = "ENFP";
const nickname = "The Campaigner";
const tagline = "Energetic, imaginative, and genuinely convinced that everything is connected.";

const strengths = [
  "Contagious enthusiasm and energy",
  "Rich imagination and creative vision",
  "Ability to read and connect with people quickly",
  "Strong emotional intelligence",
  "Sees potential in people and situations others overlook",
];

const growthEdges = [
  "Difficulty sustaining focus on a single path long-term",
  "Can over-commit and burn out",
  "Avoids conflict to a fault",
  "Sensitive to criticism; can be approval-seeking",
  "May spiral in overthinking and second-guessing",
];

const careers = [
  "Journalist / Reporter", "Creative Strategist", "Counsellor / Coach",
  "Marketing Director", "Actor / Performer", "Community Organiser",
];

const stats = [
  { label: "Population", value: "~7%" },
  { label: "Energy", value: "Extraverted" },
  { label: "Information", value: "Intuitive" },
  { label: "Decisions", value: "Feeling" },
  { label: "Lifestyle", value: "Perceiving" },
];

const loveStyle = {
  summary: `ENFPs fall in love with intensity and enthusiasm — they want to know everything about a person and bring a contagious energy to early romance. They are emotionally perceptive, physically affectionate, and deeply invested in a partner's growth and happiness. But they also need room to breathe and evolve.`,
  what_they_need: `A partner who matches their emotional depth and also gives them space to explore. ENFPs wilt in relationships that feel confining or emotionally stagnant. Intellectual chemistry and genuine curiosity about each other matter enormously.`,
  challenge: `Sustaining long-term commitment once the novelty phase fades. ENFPs can mistake the end of the honeymoon period for the end of compatibility, when in fact the real relationship is just beginning. Developing comfort with depth over excitement is their key growth area.`,
};
---

<BaseLayout
  title="ENFP Personality: Love, Strengths & Careers | TypeInsight"
  description="How does the ENFP love? Romantic style, relationship needs, career paths and growth areas for The Campaigner. MBTI 恋愛 ENFP / ENFP 恋爱."
  faqItems={[
    {
      question: "How does an ENFP act in a romantic relationship?",
      answer: "ENFPs are passionate, enthusiastic partners who bring creative energy and emotional depth to romance. They are physically affectionate and deeply curious about their partners, but need freedom and ongoing novelty to stay fully engaged.",
    },
    {
      question: "ENFP の恋愛スタイルは？(ENFP love style / ENFP 恋爱风格)",
      answer: "ENFP types fall intensely and are generous with emotional attention. They value connection and growth in a relationship, and are most fulfilled with partners who match their depth while giving them space to explore and evolve.",
    },
    {
      question: "What MBTI type is most compatible with ENFP?",
      answer: "INTJs are a frequently cited ENFP match — their strategic depth and independence complement the ENFP's warmth and spontaneity. INFJs and ENFJs can also form strong emotional bonds with ENFPs.",
    },
  ]}
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <p class="mono-cap mb-4">Your Result</p>
    <h1 class="font-sans font-extrabold text-ink leading-none mb-2" style="font-size:clamp(3.5rem,8vw,6rem);letter-spacing:-0.06em;line-height:0.9">{type}</h1>
    <p class="font-sans text-2xl font-semibold text-clay mb-4">{nickname}</p>
    <p class="font-sans text-ink-mute max-w-xl text-base leading-relaxed">{tagline}</p>
    <div class="mt-8">
      <a href="/test" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full transition-colors hover:bg-ink hover:text-paper" style="border:1px solid rgba(31,26,20,0.28)">Retake the Test</a>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-14 lg:grid lg:grid-cols-3 lg:gap-12">
    <div class="lg:col-span-2 space-y-12">
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Profile</h2>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>The ENFP — Extraverted, Intuitive, Feeling, Perceiving — is The Campaigner: a type that experiences the world as a web of possibilities and connections. ENFPs don't just meet people; they encounter them — seeking the story beneath the surface, the potential beneath the present.</p>
          <p>This type is among the most socially magnetic in the entire framework. Their enthusiasm is genuine rather than performed, which is precisely why it's so persuasive. ENFPs make outstanding advocates, storytellers, and mobilisers of people around a cause.</p>
          <p>The ENFP's challenge is depth of commitment. They are drawn to beginnings — the excitement of a new project, a new relationship, a new identity — and may struggle to sustain interest through the long middle. This isn't fickleness; it's a cognitive preference for novelty and possibilities that requires deliberate management.</p>
          <p>At their best, ENFPs synthesise their emotional intelligence, creativity, and social fluency into work that genuinely moves people. At their most stretched, they scatter energy across too many fronts and underdeliver on each. The discipline of finishing is where ENFPs most benefit from external structure or accountability.</p>
        </div>
      </section>

      <!-- Ad: 300x250 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '6d2f9a9789ee0cb5604b21dbdb334ecb',
            'format' : 'iframe',
            'height' : 250,
            'width' : 300,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/6d2f9a9789ee0cb5604b21dbdb334ecb/invoke.js"></script>
      </div>

            <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Strengths</h2>
        <ul class="space-y-3">
          {strengths.map(s => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-sage font-bold mt-0.5">&#10003;</span><span>{s}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Growth Edges</h2>
        <ul class="space-y-3">
          {growthEdges.map(g => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-clay font-bold mt-0.5">&rarr;</span><span>{g}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Career Paths</h2>
        <div class="flex flex-wrap gap-2">
          {careers.map(c => (
            <span class="font-sans text-sm font-medium px-4 py-2 rounded-full text-ink-soft"
                  style="background:#ECEFE2;border:1px solid var(--ink-line);">{c}</span>
          ))}
        </div>
      </section>

      <!-- Love & Relationships -->
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-2" style="letter-spacing:-0.04em;">
          Love &amp; Relationships
        </h2>
        <p class="font-sans text-xs text-ink-mute mb-5" style="letter-spacing:0.02em;">
          <span lang="ja">恋愛スタイル</span> &nbsp;/&nbsp; <span lang="zh-Hans">恋爱类型</span>
        </p>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>{loveStyle.summary}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            What they need in a partner
          </h3>
          <p>{loveStyle.what_they_need}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            Relationship challenge
          </h3>
          <p>{loveStyle.challenge}</p>
        </div>
      </section>
    </div>

    <aside class="mt-12 lg:mt-0 space-y-8">
      <!-- Ad: 160x300 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '70ef5f288f802563b40dd7d981408065',
            'format' : 'iframe',
            'height' : 300,
            'width' : 160,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/70ef5f288f802563b40dd7d981408065/invoke.js"></script>
      </div>

      <div class="bg-paper rounded-[36px] p-6" style="border:1px solid var(--ink-line)">
        <p class="mono-cap mb-4">At a Glance</p>
        <dl class="space-y-3">
          {stats.map(({ label, value }) => (
            <div class="flex justify-between text-sm font-sans pb-2" style="border-bottom:1px solid var(--ink-line)">
              <dt class="text-ink-mute">{label}</dt>
              <dd class="text-ink font-semibold">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <AffiliateCard type="betterhelp" />
    </aside>
  </div>
</BaseLayout>
