---
import BaseLayout from '../../components/BaseLayout.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';

const type = "ESTP";
const nickname = "The Entrepreneur";
const tagline = "Bold, perceptive, and action-first — the person who figures it out by doing it.";

const strengths = [
  "Quick-thinking and decisive in fast-moving situations",
  "Highly perceptive of people and their motivations",
  "Energetic and persuasive",
  "Pragmatic — focuses on what works, not what should work",
  "Thrives under pressure",
];

const growthEdges = [
  "Impatient with theory and long-term planning",
  "May act before thinking through consequences",
  "Can be blunt in ways that damage relationships",
  "Risk-taking that crosses into recklessness",
  "Difficulty committing to long-term projects",
];

const careers = [
  "Sales Director", "Emergency Responder / Firefighter", "Entrepreneur",
  "Stock Trader", "Sports Coach", "Detective",
];

const stats = [
  { label: "Population", value: "~4–6%" },
  { label: "Energy", value: "Extraverted" },
  { label: "Information", value: "Sensing" },
  { label: "Decisions", value: "Thinking" },
  { label: "Lifestyle", value: "Perceiving" },
];

const loveStyle = {
  summary: `ESTPs are bold, energetic, and action-oriented in romance. They are direct about attraction, confident in pursuit, and genuinely fun to be around — bringing spontaneity and physical energy to a relationship. They live in the present and make the present feel alive for their partners.`,
  what_they_need: `A partner who values independence, matches their physical energy, and doesn't require constant emotional depth or verbal reassurance. ESTPs need space to act and explore; possessiveness or emotional pressure suffocates them.`,
  challenge: `Long-term commitment and emotional vulnerability. ESTPs can find sustained intimacy — the kind that requires sitting still and going inward — genuinely uncomfortable. Moving from thrill-seeking to real partnership depth is their central relationship challenge.`,
};
---

<BaseLayout
  title="ESTP Personality: Love, Strengths & Careers | TypeInsight"
  description="How does the ESTP love? Romantic style, relationship needs, career paths and growth areas for The Entrepreneur. MBTI 恋愛 ESTP / ESTP 恋爱."
  faqItems={[
    {
      question: "How does an ESTP act in a romantic relationship?",
      answer: "ESTPs are bold, energetic partners who live in the present and make the present feel exciting. They are direct about attraction and genuinely fun, but long-term emotional depth and sustained commitment require deliberate effort from them.",
    },
    {
      question: "ESTP の恋愛スタイルは？(ESTP love style / ESTP 恋爱风格)",
      answer: "ESTP types bring spontaneity, confidence, and physical energy to romance. They are most comfortable with partners who value independence and don't require constant emotional processing or verbal reassurance.",
    },
    {
      question: "What MBTI type is most compatible with ESTP?",
      answer: "ISFJs and ISTJs are often cited as grounding matches for ESTPs — their reliability and warmth complement the ESTP's action-orientation. ISFJ is a particularly common pairing that balances the ESTP's energy with emotional steadiness.",
    },
  ]}
>
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-12">
    <p class="mono-cap mb-4">Your Result</p>
    <h1 class="font-sans font-extrabold text-ink leading-none mb-2" style="font-size:clamp(3.5rem,8vw,6rem);letter-spacing:-0.06em;line-height:0.9">{type}</h1>
    <p class="font-sans text-2xl font-semibold text-clay mb-4">{nickname}</p>
    <p class="font-sans text-ink-mute max-w-xl text-base leading-relaxed">{tagline}</p>
    <div class="mt-8">
      <a href="/test" class="inline-block font-sans text-sm font-semibold px-5 py-2.5 rounded-full transition-colors hover:bg-ink hover:text-paper" style="border:1px solid rgba(31,26,20,0.28)">Retake the Test</a>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-14 lg:grid lg:grid-cols-3 lg:gap-12">
    <div class="lg:col-span-2 space-y-12">
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Profile</h2>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>The ESTP — Extraverted, Sensing, Thinking, Perceiving — is The Entrepreneur: a type defined by presence, action, and an almost preternatural ability to read a room and a situation simultaneously. ESTPs don't plan their way into things; they engage directly and course-correct as they go.</p>
          <p>ESTPs are among the most perceptive of all types when it comes to people. They notice the micro-expressions, the inconsistencies, the social dynamics that others miss — and they use that information with remarkable effectiveness. In negotiation, sales, or any situation requiring rapid interpersonal intelligence, few types compete.</p>
          <p>The cost of this live-wire orientation is difficulty with anything that requires patience, sustained abstraction, or deferred gratification. ESTPs are future-oriented only in the immediate sense — the next hour, the next deal — and can struggle with the long arc of career-building or relationship depth.</p>
          <p>Growth for ESTPs often means slowing down enough to consider consequences before acting, and building relationships deep enough that they survive the ESTP's periods of inattention.</p>
        </div>
      </section>

      <!-- Ad: 300x250 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '6d2f9a9789ee0cb5604b21dbdb334ecb',
            'format' : 'iframe',
            'height' : 250,
            'width' : 300,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/6d2f9a9789ee0cb5604b21dbdb334ecb/invoke.js"></script>
      </div>

            <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Strengths</h2>
        <ul class="space-y-3">
          {strengths.map(s => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-sage font-bold mt-0.5">&#10003;</span><span>{s}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Growth Edges</h2>
        <ul class="space-y-3">
          {growthEdges.map(g => (
            <li class="flex gap-3 items-start font-sans text-sm text-ink">
              <span class="text-clay font-bold mt-0.5">&rarr;</span><span>{g}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-5" style="letter-spacing:-0.04em;">Career Paths</h2>
        <div class="flex flex-wrap gap-2">
          {careers.map(c => (
            <span class="font-sans text-sm font-medium px-4 py-2 rounded-full text-ink-soft"
                  style="background:#ECEFE2;border:1px solid var(--ink-line);">{c}</span>
          ))}
        </div>
      </section>

      <!-- Love & Relationships -->
      <section>
        <h2 class="font-sans font-extrabold text-xl text-ink mb-2" style="letter-spacing:-0.04em;">
          Love &amp; Relationships
        </h2>
        <p class="font-sans text-xs text-ink-mute mb-5" style="letter-spacing:0.02em;">
          <span lang="ja">恋愛スタイル</span> &nbsp;/&nbsp; <span lang="zh-Hans">恋爱类型</span>
        </p>
        <div class="font-sans text-ink-mute text-sm leading-relaxed space-y-4">
          <p>{loveStyle.summary}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            What they need in a partner
          </h3>
          <p>{loveStyle.what_they_need}</p>
          <h3 class="font-sans font-semibold text-ink text-sm" style="letter-spacing:-0.02em;">
            Relationship challenge
          </h3>
          <p>{loveStyle.challenge}</p>
        </div>
      </section>
    </div>

    <aside class="mt-12 lg:mt-0 space-y-8">
      <!-- Ad: 160x300 Banner -->
      <div>
        <script>
          atOptions = {
            'key' : '70ef5f288f802563b40dd7d981408065',
            'format' : 'iframe',
            'height' : 300,
            'width' : 160,
            'params' : {}
          };
        </script>
        <script src="https://www.highperformanceformat.com/70ef5f288f802563b40dd7d981408065/invoke.js"></script>
      </div>

      <div class="bg-paper rounded-[36px] p-6" style="border:1px solid var(--ink-line)">
        <p class="mono-cap mb-4">At a Glance</p>
        <dl class="space-y-3">
          {stats.map(({ label, value }) => (
            <div class="flex justify-between text-sm font-sans pb-2" style="border-bottom:1px solid var(--ink-line)">
              <dt class="text-ink-mute">{label}</dt>
              <dd class="text-ink font-semibold">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <AffiliateCard type="betterhelp" />
    </aside>
  </div>
</BaseLayout>
